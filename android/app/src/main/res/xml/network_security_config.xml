<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything the app talks to in production is HTTPS only, verified
         against the system certificate store. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local development only (LIVE_API=false): the PC's server reached over
         `adb reverse` or the emulator's host alias. Never a real domain. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Debug builds may additionally trust a user-installed CA (a proxy). -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
