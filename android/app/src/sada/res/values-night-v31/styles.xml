<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch screen: a solid colour with the app
         icon in a circle. The gradient is not possible here, so the colour is
         the middle of the in-app gradient and the icon is the outlined logo,
         padded to sit inside the circle mask instead of being cropped by it. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF1479B8</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
</resources>
