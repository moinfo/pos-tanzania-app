<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the same brand gradient and outlined logo
     the app shows once it is running. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF1B4F9C"
                android:centerColor="#FF14A38B"
                android:endColor="#FF2DB566"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
